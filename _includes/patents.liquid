<div class="publications patents">
  <ol class="bibliography">
    {% for p in site.data.patents %}
      <li>
        <div class="row">
          <div class="col col-sm-2 abbr">
            <abbr class="badge rounded w-100">{{ p.office }}</abbr>
          </div>
          <div class="col-sm-10">
            <div class="title">{{ p.title }}</div>
            <div class="author">Korean Patent Application No. {{ p.number }}</div>
            <div class="periodical">Filed {{ p.filed | date: '%b %-d, %Y' }} · {{ p.status }}</div>
          </div>
        </div>
      </li>
    {% endfor %}
  </ol>
</div>
